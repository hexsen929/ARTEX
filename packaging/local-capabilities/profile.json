      },
      "deferred": false
    },
    {
      "key": "shodan_search",
      "description": "用 Shodan 搜索(消耗 query 额度,每页100条)。query 支持 ssl: http.title: http.favicon.hash: product: port: org: vuln: 等过滤器。",
      "schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "description": "页码,默认1"
          },
          "query": {
            "type": "string",
            "description": "Shodan查询语句"
          }
        }
      },
