      "key": "shodan_count",
      "description": "用 Shodan 统计某查询命中的主机数与分面(country/port/org)，不返回明细、不消耗记录额度，适合先摸量。",
      "schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Shodan查询语句,如 ssl:example.com 或 http.title:admin"
          }
        }
      },
      "agents": [
        "worker",
        "pentest",
        "planner"
      ],
      "enabled": true,
      "kind": "http",
      "exec": {
        "url": "https://api.shodan.io/shodan/host/count?key=${SHODAN_API_KEY}&query={query}",
        "body": "",
        "proxy": "",
        "method": "GET",
        "headers": {},
        "timeout_ms": 30000,
        "use_recording_proxy": false
      },
      "deferred": false
    },
